[submodule "supermariowar"]
	path = supermariowar
	url = https://github.com/dborth/supermariowar.git
[submodule "SDL3-libogc2"]
	path = SDL3-libogc2
	url = https://github.com/dborth/SDL.git
	branch = ogc-port
[submodule "SDL3-wut"]
	path = SDL3-wut
	url = https://github.com/dborth/SDL.git
	branch = wut-port
	# Not fetched by `git submodule update --init --recursive` (nor by actions/checkout), so the Wii build never
	# depends on this branch. The Wii U build asks for it explicitly:
	#   git submodule update --init --checkout SDL3-wut
	update = none
